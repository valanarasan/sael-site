# Copy to .env for local development. Never commit .env.
# In production these go in the host's secret settings only.
# Used by the enquiry endpoint (src/pages/api/enquiry.ts, build step 9).

# --- Cloudflare Turnstile (spam check on the enquiry form) ---
# The site key is public (sent to the browser); the secret key is not.
# For local testing, Cloudflare publishes always-pass test keys in its Turnstile docs.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google Sheets lead store ("SAEL Leads" sheet, via a service account) ---
# Share the sheet with the service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private key from the service-account JSON, with newlines written as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
LEADS_SHEET_ID=
LEADS_SHEET_TAB=Leads

# --- Resend email notifier (alerts the sales team) ---
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "SAEL Website <enquiries@saelenergy.com>"
LEADS_EMAIL_FROM=
# Comma-separated sales list
LEADS_EMAIL_TO=

# --- Rate limit for the enquiry endpoint ---
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=600
