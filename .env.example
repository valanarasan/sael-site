# Copy to .env for local development. Never commit .env.
# In production these go in the host's secret settings only.
# Used by the enquiry endpoint (src/pages/api/enquiry.ts); the logic is in src/lib/leads.
# If a required value is missing, the endpoint answers "unavailable" (the visitor is asked to
# call) and the server log names the missing setting. It never drops a lead silently.

# --- Driver ---
# "live" (default): Turnstile + Google Sheet + Resend, all values below required.
# "memory": local development and end-to-end tests only. Leads stay in memory, no email is
# sent and every spam check passes. Never use it in production.
LEADS_DRIVER=

# --- Cloudflare Turnstile (spam check on the enquiry form) ---
# The site key is public (sent to the browser); the secret key is not.
# For local testing, Cloudflare publishes always-pass test keys in its Turnstile docs.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Google Sheets lead store ("SAEL Leads" sheet, via a service account) ---
# Share the sheet with the service account email as Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private key from the service-account JSON, with newlines written as \n.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
# The long ID in the sheet URL: docs.google.com/spreadsheets/d/<ID>/edit
LEADS_SHEET_ID=
LEADS_SHEET_TAB=Leads
# The tab's gid (the number after #gid= in its URL), for the "open row" link in the email.
LEADS_SHEET_GID=0
# Row 1 of the tab holds the headings, in this order:
# Received (IST) | Name | Phone | Interest | District / PIN | Monthly bill | Message | Page |
# UTM source | UTM medium | UTM campaign | Consent | Status | Owner

# --- Resend email notifier (alerts the sales team) ---
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "SAEL Website <enquiries@saelenergy.com>"
LEADS_EMAIL_FROM=
# Comma-separated sales list
LEADS_EMAIL_TO=

# --- Rate limit for the enquiry endpoint ---
ENQUIRY_RATE_LIMIT_MAX=5
ENQUIRY_RATE_LIMIT_WINDOW_SECONDS=600
