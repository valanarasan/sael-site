---
/**
 * Home page. Fetches content through the repository, maps it with the view models and passes
 * each section only the props it renders. Section numbers follow page order.
 */
import { getImage } from 'astro:assets';
import logo from '../assets/brand/sael-logo.png';
import Cursor from '../components/islands/Cursor.astro';
import ProgressPill from '../components/islands/ProgressPill.astro';
import Audience from '../components/sections/Audience.astro';
import Contact from '../components/sections/Contact.astro';
import DayNight from '../components/sections/DayNight.astro';
import Engineering from '../components/sections/Engineering.astro';
import Faq from '../components/sections/Faq.astro';
import Gallery from '../components/islands/Gallery.astro';
import Hero from '../components/sections/Hero.astro';
import Highlights from '../components/sections/Highlights.astro';
import Numbers from '../components/sections/Numbers.astro';
import Process from '../components/sections/Process.astro';
import Projects from '../components/sections/Projects.astro';
import Subsidy from '../components/sections/Subsidy.astro';
import Systems from '../components/sections/Systems.astro';
import Why from '../components/sections/Why.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { MAX_KW, MIN_KW } from '../lib/chat';
import { mailtoHref, telHref, whatsappHref } from '../lib/contact';
import { getFaqs, getProjects, getSections, getSettings, getSubsidyRules } from '../lib/content';
import Loader from '../components/ui/Loader.astro';
import PhotoPreload from '../components/ui/PhotoPreload.astro';
import { jsonLdString, toLocalBusinessJsonLd } from '../lib/json-ld';
import { HERO_PHOTO } from '../lib/photo';
import { SHARE_IMAGE } from '../lib/share-image';
import { fillTokens } from '../lib/text';
import { toProjectsView } from '../lib/view-models/projects';
import { toLocalBusinessInput } from '../lib/view-models/seo';
import { toCalculatorView, toSlabRows, toStateOptions } from '../lib/view-models/subsidy';
import { tokenValues } from '../lib/view-models/tokens';

const [sections, settings, rules, faqs, projects] = await Promise.all([
  getSections(),
  getSettings(),
  getSubsidyRules(),
  getFaqs(),
  getProjects(),
]);

const DEFAULT_KW = 3;
let sectionNumber = 0;
const next = () => ++sectionNumber;

const tokens = tokenValues(settings);
const { contact } = sections;
const [mainSlide] = sections.hero.slides;

const base = Astro.site ?? Astro.url;
const [logoImage, shareImage] = await Promise.all([
  getImage({ src: logo, width: 120, format: 'png' }),
  mainSlide ? getImage({ src: mainSlide.image, ...SHARE_IMAGE }) : undefined,
]);
const localBusiness = jsonLdString(
  toLocalBusinessJsonLd(
    toLocalBusinessInput(settings, {
      url: new URL('/', base).href,
      logoUrl: new URL(logoImage.src, base).href,
      imageUrl: new URL((shareImage ?? logoImage).src, base).href,
    }),
  ),
);
---

<BaseLayout image={mainSlide && { src: mainSlide.image, alt: mainSlide.alt }}>
  <script slot="head" is:inline type="application/ld+json" set:html={localBusiness} />
  {mainSlide && <PhotoPreload slot="head" src={mainSlide.image} {...HERO_PHOTO} />}
  <Loader {...sections.loader} />
  <Hero {...sections.hero} />
  <Highlights {...sections.highlights} />
  <Systems number={next()} {...sections.systems} />
  <Subsidy
    number={next()}
    {...sections.subsidy}
    slabs={toSlabRows(rules)}
    states={toStateOptions(rules)}
    view={toCalculatorView(DEFAULT_KW, rules.defaultStateId, rules)}
    rules={rules}
    minKw={MIN_KW}
    maxKw={MAX_KW}
  />
  <Process number={next()} {...sections.process} />
  <Why number={next()} {...sections.why} />
  <Engineering number={next()} {...sections.engineering} />
  <Gallery number={next()} {...sections.gallery} />
  <Numbers {...sections.numbers} />
  <Projects number={next()} {...sections.projects} {...toProjectsView(projects)} />
  <Audience number={next()} {...sections.audience} />
  <Faq
    number={next()}
    eyebrow={sections.faq.eyebrow}
    heading={sections.faq.heading}
    intro={fillTokens(sections.faq.intro, tokens)}
    items={faqs}
  />
  <Contact
    number={next()}
    eyebrow={contact.eyebrow}
    heading={contact.heading}
    intro={contact.intro}
    poster={contact.background.image}
    videoSrc={contact.video}
    form={contact.form}
    offices={settings.offices.map((o) => ({
      name: o.name,
      ...(o.phone ? { phone: { label: o.phone.display, href: telHref(o.phone.e164) } } : {}),
    }))}
    email={{ label: settings.contact.email, href: mailtoHref(settings.contact.email) }}
    whatsappLink={whatsappHref(settings.contact.whatsapp, contact.form.whatsappMessage)}
  />
  <DayNight number={next()} {...sections.dayNight} />
  <ProgressPill sections={sections.progress} />
  <Cursor />
</BaseLayout>

<script>
  // GSAP, ScrollTrigger and Lenis download only when the visitor allows motion.
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    void import('../lib/motion').then((m) => m.initMotion());
  }
</script>
