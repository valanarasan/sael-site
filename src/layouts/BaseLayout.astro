---
/**
 * Page shell: <head> (meta, fonts, favicon), skip link, header, menu sheet, footer and mobile bar.
 * Reads settings through the content repository and maps them to the chrome components' props.
 */
import type { ImageMetadata } from 'astro';
import { Font, getImage } from 'astro:assets';
import '../styles/global.css';
import Footer from '../components/sections/Footer.astro';
import Header from '../components/sections/Header.astro';
import MobileBar from '../components/sections/MobileBar.astro';
import ChatAssistant from '../components/islands/ChatAssistant.astro';
import MenuSheet from '../components/islands/MenuSheet.astro';
import { whatsappHref } from '../lib/contact';
import { getChat, getSettings } from '../lib/content';
import { SHARE_IMAGE } from '../lib/share-image';
import { toChrome } from '../lib/view-models/chrome';

interface Props {
  /** Page title; the site name is appended. Omit on the home page to use the default title. */
  title?: string;
  /** Meta description; defaults to the site description from settings. */
  description?: string;
  noindex?: boolean;
  /** Link-preview image, cropped to 1200 × 630. */
  image?: { src: ImageMetadata; alt: string } | undefined;
  /** Open Graph type: "article" on blog posts. */
  ogType?: 'website' | 'article';
}

const { title, description, noindex = false, image, ogType = 'website' } = Astro.props;

const [settings, chat] = await Promise.all([getSettings(), getChat()]);
const chrome = toChrome(settings, Astro.url.pathname, new Date().getFullYear());

const pageTitle = title ? `${title} · ${settings.company.name}` : settings.seo.title;
const pageDescription = description ?? settings.seo.description;
// A page that asks not to be indexed has no preferred address to point search engines at.
const canonical = Astro.site && !noindex ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const menuId = 'menu-sheet';

const share = image ? await getImage({ src: image.src, ...SHARE_IMAGE }) : undefined;
const shareUrl = share ? new URL(share.src, Astro.site ?? Astro.url).href : undefined;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // Before first paint: allow the hero intro unless the visitor prefers reduced motion.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.documentElement.classList.add('motion-ok');
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#F1F3F1" />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={settings.company.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content="en_IN" />
    {shareUrl && image && (
      <>
        <meta property="og:image" content={shareUrl} />
        <meta property="og:image:width" content={String(SHARE_IMAGE.width)} />
        <meta property="og:image:height" content={String(SHARE_IMAGE.height)} />
        <meta property="og:image:alt" content={image.alt} />
        <meta name="twitter:card" content="summary_large_image" />
      </>
    )}

    <Font
      cssVariable="--font-jakarta"
      preload={[
        { weight: 400, subset: 'latin' },
        { weight: 700, subset: 'latin' },
      ]}
    />
    <Font cssVariable="--font-newsreader" />
    <Font cssVariable="--font-plex-mono" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <Header {...chrome.header} menuId={menuId} />
    <MenuSheet {...chrome.menu} id={menuId} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer {...chrome.footer} />
    <MobileBar {...chrome.mobileBar} />
    <ChatAssistant
      title={chat.title}
      subtitle={chat.subtitle}
      openLabel={chat.openLabel}
      inputLabel={chat.inputLabel}
      inputPlaceholder={chat.inputPlaceholder}
      note={chat.note}
      closeLabel={chat.closeLabel}
      sendLabel={chat.sendLabel}
      chipsLabel={chat.chipsLabel}
      readLabel={chat.readLabel}
      chips={chat.chips}
      offline={{
        text: chat.fallback.answer,
        whatsappHref: whatsappHref(settings.contact.whatsapp, chat.whatsappChip.whatsapp),
        whatsappLabel: chat.whatsappLabel,
      }}
    />
  </body>
</html>
