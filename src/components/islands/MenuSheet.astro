---
/**
 * Full-height menu sheet that slides in from the right (v5 "sheet").
 * Built on a native modal <dialog>: focus is trapped, the page behind is inert, Escape closes,
 * and focus returns to the Menu button. Any element with [data-menu-open] opens it.
 */
import type { MenuSheetProps } from '../../lib/view-models/chrome';

type Props = MenuSheetProps & { id: string };

const { id, links, email, phone } = Astro.props;
const titleId = `${id}-title`;
---

<dialog class="sheet" id={id} aria-labelledby={titleId} data-menu-sheet>
  <div class="sc" data-menu-close aria-hidden="true"></div>
  <div class="sp">
    <h2 class="sr-only" id={titleId}>
      Menu
    </h2>
    <button class="x" type="button" data-menu-close autofocus>
      Close <span aria-hidden="true">✕</span>
    </button>
    <nav aria-label="Menu">
      {links.map((link, i) => (
        <a href={link.href} aria-current={link.current}>
          {link.label} <small aria-hidden="true">{String(i + 1).padStart(2, '0')}</small>
        </a>
      ))}
    </nav>
    <p class="contact">
      <a href={email.href}>{email.label}</a>
      <br />
      <a href={phone.href}>{phone.label}</a>
    </p>
  </div>
</dialog>

<script>
  const sheets = document.querySelectorAll<HTMLDialogElement>('[data-menu-sheet]');

  sheets.forEach((sheet) => {
    const panel = sheet.querySelector<HTMLElement>('.sp');
    const openers = document.querySelectorAll<HTMLElement>(
      `[data-menu-open][aria-controls="${sheet.id}"]`,
    );
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let closeTimer: number | undefined;

    const setExpanded = (open: boolean) =>
      openers.forEach((btn) => btn.setAttribute('aria-expanded', String(open)));

    const finishClose = () => {
      window.clearTimeout(closeTimer);
      if (sheet.open) sheet.close();
    };

    const open = () => {
      window.clearTimeout(closeTimer);
      sheet.showModal();
      document.documentElement.classList.add('menu-open');
      setExpanded(true);
      // Next frame so the slide-in transition runs from the closed position.
      requestAnimationFrame(() => requestAnimationFrame(() => sheet.classList.add('open')));
    };

    const close = () => {
      if (!sheet.open) return;
      sheet.classList.remove('open');
      document.documentElement.classList.remove('menu-open');
      setExpanded(false);
      if (reducedMotion.matches || !panel) {
        finishClose();
        return;
      }
      panel.addEventListener('transitionend', finishClose, { once: true });
      closeTimer = window.setTimeout(finishClose, 900); // fallback if transitionend never fires
    };

    openers.forEach((btn) => btn.addEventListener('click', open));
    sheet
      .querySelectorAll('[data-menu-close]')
      .forEach((el) => el.addEventListener('click', close));
    // Following a link closes the sheet; scrolling is unlocked first so section links can jump.
    sheet.querySelectorAll('nav a').forEach((a) => a.addEventListener('click', close));
    sheet.addEventListener('cancel', (event) => {
      event.preventDefault(); // Escape: run the animated close instead of an instant one
      close();
    });
  });
</script>

<style>
  .sheet {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    z-index: 120;
    overflow: hidden;
  }

  .sheet[open] {
    display: grid;
    grid-template-columns: 1fr minmax(320px, 40vw);
  }

  .sheet::backdrop {
    background: transparent;
  }

  .sc {
    background: rgba(11, 31, 34, 0.35);
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .sp {
    position: relative;
    background: var(--ink);
    color: var(--paper);
    padding: 110px 48px 48px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    overflow-y: auto;
    transform: translateX(100%);
    transition: transform 0.8s var(--ease);
  }

  .sheet:global(.open) .sc {
    opacity: 1;
  }

  .sheet:global(.open) .sp {
    transform: none;
  }

  nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  nav a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line-d);
    color: var(--paper);
    text-decoration: none;
    font: 600 34px var(--f-disp);
    letter-spacing: -0.03em;
    transition:
      color 0.3s ease,
      padding 0.5s var(--ease);
  }

  nav a small {
    font: 500 12px var(--f-mono);
    color: rgba(241, 243, 241, 0.5);
  }

  nav a:hover {
    color: var(--copper-2);
    padding-left: 10px;
  }

  .x {
    position: absolute;
    right: 40px;
    top: 28px;
    background: none;
    border: 0;
    padding: 8px 0;
    cursor: pointer;
    font: 600 14px var(--f-disp);
    color: var(--paper);
  }

  .contact {
    margin-top: auto;
    padding-top: 24px;
    font-size: 14px;
    color: rgba(241, 243, 241, 0.6);
  }

  .contact a {
    color: inherit;
    text-decoration: none;
  }

  .contact a:hover {
    color: var(--copper-2);
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  @media (max-width: 860px) {
    .sheet[open] {
      grid-template-columns: 0 1fr;
    }
  }
</style>
