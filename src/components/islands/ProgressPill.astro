---
/**
 * Desktop progress pill (v5): names the section in view ("03 · How it works") with a ring for
 * scroll progress, and underlines the matching link in the header. Decorative, so hidden from
 * screen readers; the page's headings and landmarks carry the same information.
 */
import type { Sections } from '../../lib/schemas/sections';

interface Props {
  sections: Sections['progress'];
}

const { sections } = Astro.props;
const first = sections[0];
const RING = 94.25; // 2πr for r = 15
---

<div class="prog" aria-hidden="true" data-progress data-sections={JSON.stringify(sections)}>
  <svg viewBox="0 0 36 36">
    <circle
      cx="18"
      cy="18"
      r="15"
      fill="none"
      stroke="rgba(11,31,34,.12)"
      stroke-width="3"
    ></circle>
    <circle
      class="ring"
      cx="18"
      cy="18"
      r="15"
      fill="none"
      stroke="#E8692E"
      stroke-width="3"
      stroke-linecap="round"
      stroke-dasharray={RING}
      stroke-dashoffset={RING}
      data-progress-ring
    ></circle>
  </svg>
  <span class="nm" data-progress-name>
    01 · {first?.label}
  </span>
</div>

<script>
  const RING = 94.25;
  document.querySelectorAll<HTMLElement>('[data-progress]').forEach((pill) => {
    const list = JSON.parse(pill.dataset.sections ?? '[]') as { id: string; label: string }[];
    const sections = list
      .map((s, i) => ({
        ...s,
        n: String(i + 1).padStart(2, '0'),
        el: document.getElementById(s.id),
      }))
      .filter((s): s is typeof s & { el: HTMLElement } => s.el !== null);
    const ring = pill.querySelector<SVGCircleElement>('[data-progress-ring]');
    const name = pill.querySelector<HTMLElement>('[data-progress-name]');
    const links = [...document.querySelectorAll<HTMLAnchorElement>('nav[aria-label="Main"] a')];
    let queued = false;
    let current = '';

    const update = () => {
      queued = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      ring?.setAttribute(
        'stroke-dashoffset',
        String(RING * (1 - (max > 0 ? window.scrollY / max : 0))),
      );
      let cur = sections[0];
      for (const s of sections)
        if (s.el.getBoundingClientRect().top < window.innerHeight * 0.5) cur = s;
      if (!cur || cur.id === current) return;
      current = cur.id;
      if (name) name.textContent = `${cur.n} · ${cur.label}`;
      links.forEach((a) => a.classList.toggle('act', new URL(a.href).hash === `#${cur.id}`));
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  });
</script>

<style>
  .prog {
    position: fixed;
    left: max(var(--gut-l), 24px);
    bottom: calc(env(safe-area-inset-bottom, 0px) + 22px);
    z-index: 85;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 16px 8px 8px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.85);
    box-shadow: 0 10px 30px rgba(11, 31, 34, 0.12);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    font: 500 12px var(--f-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
  }

  svg {
    width: 34px;
    height: 34px;
    transform: rotate(-90deg);
  }

  .nm {
    display: inline-block;
    min-width: 9ch;
  }

  @media (max-width: 860px) {
    .prog {
      display: none;
    }
  }
</style>
