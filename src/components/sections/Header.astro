---
/** Fixed top bar: logo, main nav (desktop), primary CTA and the Menu button that opens MenuSheet. */
import type { HeaderProps } from '../../lib/view-models/chrome';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';

type Props = HeaderProps & { menuId: string };

const { homeHref, logoAlt, links, cta, menuId } = Astro.props;
---

<header class="top" data-top-bar>
  <div class="top-in">
    <Logo href={homeHref} alt={logoAlt} height={54} eager />
    <nav class="links" aria-label="Main">
      {links.map((link) => (
        <a href={link.href} aria-current={link.current}>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="top-r">
      <Button href={cta.href} variant="ink" size="sm" arrow class="cta">
        {cta.label}
      </Button>
      <button
        class="txtbtn"
        type="button"
        data-menu-open
        aria-controls={menuId}
        aria-expanded="false"
        aria-haspopup="dialog"
      >
        Menu{' '}
        <i aria-hidden="true">
          <b></b>
          <b></b>
        </i>
      </button>
    </div>
  </div>
</header>

<script>
  // Solid background after a little scroll; hide when scrolling down past the hero, show on scroll up.
  const bar = document.querySelector<HTMLElement>('[data-top-bar]');
  if (bar) {
    let lastY = window.scrollY;
    let queued = false;
    const update = () => {
      queued = false;
      const y = window.scrollY;
      bar.classList.toggle('solid', y > 40);
      if (y > 500 && y > lastY + 6) bar.classList.add('hide');
      else if (y < lastY - 6) bar.classList.remove('hide');
      lastY = y;
    };
    // Keyboard users tabbing into a hidden bar must see it.
    bar.addEventListener('focusin', () => bar.classList.remove('hide'));
    window.addEventListener(
      'scroll',
      () => {
        if (!queued) {
          queued = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
    update();
  }
</script>

<style>
  .top {
    position: fixed;
    left: 0;
    right: 0;
    top: 0;
    z-index: 90;
    padding-top: env(safe-area-inset-top, 0px);
    transition:
      transform 0.6s var(--ease),
      background 0.4s ease,
      box-shadow 0.4s ease;
  }

  .top:global(.solid) {
    background: rgba(241, 243, 241, 0.86);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 1px 0 var(--line);
  }

  .top:global(.hide) {
    transform: translateY(-110%);
  }

  .top-in {
    max-width: var(--wrap-max);
    margin: 0 auto;
    padding: 18px max(var(--gut-r), 40px) 18px max(var(--gut-l), 40px);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
  }

  .links {
    display: flex;
    gap: 30px;
  }

  .links a {
    position: relative;
    color: var(--ink);
    text-decoration: none;
    font-size: 15px;
    font-weight: 500;
    padding: 6px 0;
  }

  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1.5px;
    background: var(--copper);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.5s var(--ease);
  }

  .links a:hover::after,
  .links a:global(.act)::after,
  .links a[aria-current]::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }

  .top-r {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 18px;
  }

  .txtbtn {
    background: none;
    border: 0;
    padding: 8px 0;
    cursor: pointer;
    font: 600 14px var(--f-disp);
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .txtbtn i {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .txtbtn i b {
    display: block;
    width: 22px;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }

  .txtbtn:hover i b:last-child {
    transform: translateX(-6px);
  }

  @media (max-width: 1020px) {
    .links {
      display: none;
    }

    .top-in {
      grid-template-columns: 1fr auto;
    }
  }

  @media (max-width: 560px) {
    .top-r :global(.cta) {
      display: none;
    }
  }
</style>
