---
/** White strip under the hero: what every installation includes. */
import type { Sections } from '../../lib/schemas/sections';
import Icon from '../ui/Icon.astro';

type Props = Sections['highlights'];

const { label, items } = Astro.props;
---

<section class="hl" aria-label={label}>
  <ul class="wrap hl-in" data-motion="stagger-up">
    {items.map((item) => (
      <li>
        <span class="hi">
          <Icon name={item.icon} />
        </span>
        <p>
          <b>{item.title}</b>
          <span>{item.text}</span>
        </p>
      </li>
    ))}
  </ul>
</section>

<style>
  .hl {
    background: var(--white);
    border-block: 1px solid var(--line);
  }

  .hl-in {
    list-style: none;
    margin-block: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
  }

  li {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 26px 22px;
    border-left: 1px solid var(--line);
  }

  li:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .hi {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    background: var(--paper-2);
    color: var(--teal);
  }

  p {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }

  b {
    font-weight: 700;
    font-size: 16px;
  }

  p span {
    font-size: 14px;
    color: var(--muted);
  }

  @media (max-width: 1020px) {
    .hl-in {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    li:nth-child(3) {
      border-left: 0;
      padding-left: 0;
    }
  }

  @media (max-width: 560px) {
    .hl-in {
      grid-template-columns: minmax(0, 1fr);
    }

    li {
      border-left: 0;
      padding-left: 0;
      padding-block: 16px;
      border-top: 1px solid var(--line);
    }

    li:first-child {
      border-top: 0;
    }
  }
</style>
