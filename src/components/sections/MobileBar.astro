---
/**
 * Phone-only quick-contact bar fixed to the bottom (v5 "mbar").
 * Slides away while any element marked [data-mbar-hide] (footer, contact section) is on screen.
 */
import type { MobileBarProps } from '../../lib/view-models/chrome';

type Props = MobileBarProps;

const { callHref, cta } = Astro.props;
---

<nav class="mbar" aria-label="Quick contact" data-mbar>
  <a href={callHref}>
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"></path>
    </svg>
    Call
  </a>
  <a class="go" href={cta.href}>
    {cta.label}
  </a>
</nav>

<script>
  const bar = document.querySelector<HTMLElement>('[data-mbar]');
  const targets = document.querySelectorAll<HTMLElement>('[data-mbar-hide]');
  if (bar && targets.length > 0) {
    const onScreen = new Set<Element>();
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) =>
        entry.isIntersecting ? onScreen.add(entry.target) : onScreen.delete(entry.target),
      );
      bar.classList.toggle('away', onScreen.size > 0);
    });
    targets.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .mbar {
    display: none;
  }

  @media (max-width: 860px) {
    .mbar {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 8px;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 12px);
      z-index: 95;
      padding: 8px;
      border-radius: 18px;
      background: rgba(11, 31, 34, 0.94);
      transition: transform 0.5s var(--ease);
    }

    .mbar:global(.away) {
      transform: translateY(140%);
    }

    .mbar a {
      min-height: 48px;
      padding: 0 18px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      color: #fff;
      text-decoration: none;
      font: 700 15px var(--f-disp);
      background: rgba(255, 255, 255, 0.1);
    }

    .mbar a.go {
      background: var(--copper);
    }
  }
</style>
