---
/**
 * 01 · Compare systems: comparison table plus the system finder.
 * The finder is an island (islands/SystemFinder.astro); it highlights the suggested column here.
 */
import type { Sections } from '../../lib/schemas/sections';
import SystemFinder from '../islands/SystemFinder.astro';
import SectionHeading from '../ui/SectionHeading.astro';

type Props = Sections['systems'] & { number: number };

const { number, eyebrow, heading, table, finder } = Astro.props;
const keys = ['onGrid', 'offGrid', 'hybrid'] as const;
---

<section class="sec flush-top" id="systems" aria-labelledby="h-sys" data-systems>
  <div class="wrap">
    <SectionHeading id="h-sys" number={number} eyebrow={eyebrow} heading={heading} />
    <div class="cmpx">
      <div class="cmp-t" data-motion="stagger-left" role="table" aria-label={table.label}>
        <div class="r h" role="row">
          <span role="columnheader">
            <span class="sr-only">Feature</span>
          </span>
          {keys.map((k) => (
            <span role="columnheader" data-system={k} class:list={[k === 'onGrid' && 'pick']}>
              {table.columns[k]}
            </span>
          ))}
        </div>
        {table.rows.map((row) => (
          <div class="r" role="row">
            <span role="rowheader">{row.label}</span>
            {keys.map((k) => (
              <span role="cell" data-system={k} class:list={[k === 'onGrid' && 'pick']}>
                {row.tick && row[k] !== '—' && (
                  <i class="y" aria-hidden="true">
                    ✓
                  </i>
                )}
                {row[k]}
              </span>
            ))}
          </div>
        ))}
      </div>

      <SystemFinder {...finder} />
    </div>
  </div>
</section>

<style>
  .cmpx {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: 20px;
    align-items: stretch;
  }

  .cmp-t {
    border-radius: 28px;
    border: 1px solid var(--line);
    background: var(--white);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .r {
    flex: 1 1 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) repeat(3, minmax(0, 1fr));
    align-items: center;
    border-top: 1px solid var(--line);
  }

  .r:first-child {
    border-top: 0;
  }

  .r > span {
    height: 100%;
    display: flex;
    align-items: center;
    padding: 16px 18px;
    font-size: 15px;
    transition:
      background 0.5s var(--ease),
      color 0.5s var(--ease);
  }

  .r > span[role='rowheader'] {
    color: var(--muted);
    font-size: 14px;
  }

  .h > span {
    font: 600 12px var(--f-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal);
    padding-block: 20px;
  }

  .r > span:global(.pick) {
    background: rgba(232, 105, 46, 0.08);
  }

  .h > span:global(.pick) {
    background: var(--copper);
    color: var(--ink);
  }

  .y {
    font-style: normal;
    color: var(--teal-2);
    font-weight: 800;
    margin-right: 6px;
  }

  @media (max-width: 860px) {
    .cmpx {
      grid-template-columns: minmax(0, 1fr);
    }

    .r > span {
      padding: 12px 10px;
      font-size: 13px;
    }

    .h > span {
      font-size: 10px;
      letter-spacing: 0.08em;
    }
  }
</style>
