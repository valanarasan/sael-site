---
/**
 * 02 · PM Surya Ghar: slab list and the subsidy calculator.
 * The calculator renders its default (3 kW, default state) server-side; step 6 makes it live.
 */
import type { Sections } from '../../lib/schemas/sections';
import type { CalculatorView, SlabRow, StateOption } from '../../lib/view-models/subsidy';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

type Props = Omit<Sections['subsidy'], 'eyebrow' | 'heading'> & {
  number: number;
  eyebrow: string;
  heading: string;
  slabs: SlabRow[];
  states: StateOption[];
  view: CalculatorView;
  minKw: number;
  maxKw: number;
};

const {
  number,
  eyebrow,
  heading,
  intro,
  handles,
  calculator: c,
  slabs,
  states,
  view,
  minKw,
  maxKw,
} = Astro.props;
---

<section class="sec flush-top" id="subsidy" aria-labelledby="h-sub">
  <div class="wrap sub">
    <div>
      <SectionHeading
        id="h-sub"
        number={number}
        eyebrow={eyebrow}
        heading={heading}
        layout="inline"
        class="sub-hd"
      />
      <p class="sub-in">{intro}</p>
      <dl class="slabs">
        {slabs.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
      <ul class="handle">
        {handles.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    </div>

    <div class="calc on-dark" data-calculator>
      <div class="calc-h">
        <span class="lbl">{c.label}</span>
        <span class="kw" aria-hidden="true">
          <b data-kw-value>{view.kw}</b> kW
        </span>
      </div>
      <label class="rg" for="calc-kw">
        {c.sizeLabel}
        <input
          id="calc-kw"
          type="range"
          min={minKw}
          max={maxKw}
          step="1"
          value={view.kw}
          aria-valuetext={`${view.kw} kW`}
        />
      </label>
      <label class="rg" for="calc-state">
        {c.stateLabel}
        <select id="calc-state">
          {states.map((s) => (
            <option value={s.value} selected={s.selected}>
              {s.label}
            </option>
          ))}
        </select>
      </label>
      <dl class="out" aria-live="polite">
        {view.slabRows.map((row) => (
          <div class:list={[row.dim && 'dim']} data-slab-row>
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
        <div class:list={['st-row', view.state.dim && 'dim']} data-state-row>
          <dt data-state-label>
            {view.state.name
              ? c.namedStateTopUpLabel.replace('{state}', view.state.name)
              : c.stateTopUpLabel}
          </dt>
          <dd>{view.state.value}</dd>
        </div>
        <div class="tot">
          <dt data-total-label>
            {view.total.combined ? c.combinedTotalLabel : c.centralTotalLabel}
          </dt>
          <dd data-total>{view.total.value}</dd>
        </div>
      </dl>
      <p class="snote" data-state-note>
        {view.note}
      </p>
      <p class="note">{c.note}</p>
      <Button href={c.cta.href} variant="cop" arrow class="go">
        {c.cta.label}
      </Button>
    </div>
  </div>
</section>

<style>
  .sub {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }

  .sub :global(.sub-hd) {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sub :global(.sub-hd h2) {
    font-size: clamp(40px, 4.8vw, 74px);
    line-height: 0.98;
  }

  .sub-in {
    margin-top: 22px;
    max-width: 52ch;
    color: var(--ink-2);
  }

  dl {
    margin: 0;
  }

  dd {
    margin: 0;
  }

  .slabs {
    margin-top: 30px;
    border-top: 1px solid var(--line);
  }

  .slabs div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .slabs dt {
    font-size: 15px;
    color: var(--muted);
  }

  .slabs dd {
    font: 700 20px var(--f-disp);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .handle {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .handle li {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 14px;
    font-weight: 600;
    color: var(--teal);
  }

  .handle li::before {
    content: '✓ ';
    color: var(--copper);
  }

  .calc {
    background: var(--ink);
    color: var(--paper);
    border-radius: 28px;
    padding: clamp(24px, 3vw, 40px);
    display: flex;
    flex-direction: column;
    gap: 22px;
    box-shadow: 0 40px 80px -40px rgba(11, 31, 34, 0.5);
  }

  .calc-h {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .calc-h .lbl {
    color: rgba(241, 243, 241, 0.6);
  }

  .kw {
    font: 500 15px var(--f-mono);
    color: rgba(241, 243, 241, 0.7);
  }

  .kw b {
    font: 800 56px/1 var(--f-disp);
    letter-spacing: -0.05em;
    color: #fff;
    margin-right: 4px;
  }

  .rg {
    display: flex;
    flex-direction: column;
    gap: 12px;
    font: 500 12px var(--f-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(241, 243, 241, 0.6);
  }

  .rg input {
    width: 100%;
    accent-color: var(--copper);
    height: 28px;
    cursor: pointer;
  }

  .rg select {
    width: 100%;
    min-height: 48px;
    margin-top: 8px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid var(--line-d);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    font: 600 16px var(--f-disp);
    text-transform: none;
    letter-spacing: 0;
  }

  .rg select option {
    color: var(--ink);
  }

  .out div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--line-d);
    transition: opacity 0.4s ease;
  }

  .out dt {
    font-size: 15px;
    color: rgba(241, 243, 241, 0.72);
  }

  .out dd {
    font: 700 22px var(--f-disp);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .out .st-row dd {
    color: var(--mint);
  }

  .out .tot {
    border-bottom: 0;
    padding-top: 18px;
  }

  .out .tot dt {
    color: #fff;
    font-weight: 600;
  }

  .out .tot dd {
    font: 800 clamp(38px, 4vw, 54px) / 1 var(--f-disp);
    letter-spacing: -0.04em;
    color: var(--copper-2);
  }

  /* Dimmed rows use a dimmer colour, not opacity, so the text keeps 5.5:1 contrast. */
  .out :global(.dim) dt,
  .out :global(.dim) dd {
    color: rgba(241, 243, 241, 0.55);
  }

  .snote {
    font-size: 13px;
    line-height: 1.5;
    color: var(--mint);
    min-height: 1.5em;
  }

  .snote:empty {
    display: none;
  }

  .note {
    font-size: 13px;
    color: rgba(241, 243, 241, 0.55);
  }

  .calc :global(.go) {
    align-self: flex-start;
  }

  @media (max-width: 860px) {
    .sub {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
