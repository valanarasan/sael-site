---
/**
 * 02 · PM Surya Ghar: slab list and the subsidy calculator.
 * The calculator is an island (islands/SubsidyCalculator.astro).
 */
import type { Sections } from '../../lib/schemas/sections';
import type { CalculatorView, SlabRow, StateOption } from '../../lib/view-models/subsidy';
import type { SubsidyRules } from '../../lib/schemas/subsidy';
import SubsidyCalculator from '../islands/SubsidyCalculator.astro';
import SectionHeading from '../ui/SectionHeading.astro';

type Props = Omit<Sections['subsidy'], 'eyebrow' | 'heading'> & {
  number: number;
  eyebrow: string;
  heading: string;
  slabs: SlabRow[];
  states: StateOption[];
  view: CalculatorView;
  minKw: number;
  maxKw: number;
  rules: SubsidyRules;
};

const {
  number,
  eyebrow,
  heading,
  intro,
  handles,
  calculator: c,
  slabs,
  states,
  view,
  minKw,
  maxKw,
  rules,
} = Astro.props;
---

<section class="sec flush-top" id="subsidy" aria-labelledby="h-sub">
  <div class="wrap sub">
    <div>
      <SectionHeading
        id="h-sub"
        number={number}
        eyebrow={eyebrow}
        heading={heading}
        layout="inline"
        class="sub-hd"
      />
      <p class="sub-in">{intro}</p>
      <dl class="slabs">
        {slabs.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.value}</dd>
          </div>
        ))}
      </dl>
      <ul class="handle">
        {handles.map((h) => (
          <li>{h}</li>
        ))}
      </ul>
    </div>

    <SubsidyCalculator
      {...c}
      states={states}
      view={view}
      minKw={minKw}
      maxKw={maxKw}
      rules={rules}
    />
  </div>
</section>

<style>
  .sub {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: center;
  }

  .sub :global(.sub-hd) {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sub :global(.sub-hd h2) {
    font-size: clamp(40px, 4.8vw, 74px);
    line-height: 0.98;
  }

  .sub-in {
    margin-top: 22px;
    max-width: 52ch;
    color: var(--ink-2);
  }

  dl {
    margin: 0;
  }

  dd {
    margin: 0;
  }

  .slabs {
    margin-top: 30px;
    border-top: 1px solid var(--line);
  }

  .slabs div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--line);
  }

  .slabs dt {
    font-size: 15px;
    color: var(--muted);
  }

  .slabs dd {
    font: 700 20px var(--f-disp);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .handle {
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .handle li {
    padding: 8px 14px;
    border-radius: 999px;
    background: var(--paper-2);
    font-size: 14px;
    font-weight: 600;
    color: var(--teal);
  }

  .handle li::before {
    content: '✓ ';
    color: var(--copper);
  }

  @media (max-width: 860px) {
    .sub {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
