---
/**
 * Reading column for an article's Markdown. Styles every element Markdown can produce
 * (headings, lists, quotes, tables, images, code) in the v5 type scale.
 */
---

<div class="wrap">
  <div class="prose" data-prose>
    <slot />
  </div>
</div>

<style>
  .prose {
    max-width: 720px;
    margin: clamp(48px, 6vw, 80px) auto 0;
    font-size: 18px;
    line-height: 1.75;
    color: var(--ink-2);
  }

  .prose :global(> * + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    margin-top: 2.2em;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.12;
    color: var(--ink);
    scroll-margin-top: 110px;
  }

  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: clamp(21px, 2vw, 25px);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--ink);
    scroll-margin-top: 110px;
  }

  .prose :global(h4) {
    margin: 1.6em 0 0;
    font: 500 13px var(--f-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .prose :global(h2 + *),
  .prose :global(h3 + *),
  .prose :global(h4 + *) {
    margin-top: 0.6em;
  }

  .prose :global(strong) {
    color: var(--ink);
    font-weight: 700;
  }

  .prose :global(a) {
    color: var(--teal);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--copper-text);
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
  }

  .prose :global(li + li) {
    margin-top: 0.4em;
  }

  .prose :global(li::marker) {
    color: var(--copper-text);
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding: 4px 0 4px 24px;
    border-left: 3px solid var(--copper);
    font: italic 400 clamp(22px, 2.2vw, 26px) / 1.45 var(--f-ser);
    color: var(--ink);
  }

  .prose :global(img) {
    width: 100%;
    height: auto;
    border-radius: 20px;
  }

  .prose :global(hr) {
    border: 0;
    border-top: 1px solid var(--line);
    margin-block: 2.4em;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
    display: block;
    overflow-x: auto;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th) {
    font: 500 12px var(--f-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .prose :global(code) {
    font: 0.9em var(--f-mono);
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: var(--paper-2);
  }

  .prose :global(pre) {
    padding: 18px 20px;
    border-radius: 16px;
    background: var(--ink);
    color: var(--paper);
    overflow-x: auto;
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
  }
</style>
