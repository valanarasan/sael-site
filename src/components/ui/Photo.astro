---
/**
 * A content photo: AVIF + WebP at several widths through astro:assets, with width/height set so
 * nothing shifts while loading. Lazy by default; `priority` is for the first hero image only.
 * The <picture> wrapper is display:contents so the <img> can be styled as if it stood alone.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The `sizes` attribute, e.g. "(max-width: 860px) 100vw, 50vw". */
  sizes: string;
  class?: string;
  /** First hero image only: loads eagerly with fetchpriority="high". */
  priority?: boolean;
  /** Largest width to generate; defaults to the original's width. */
  maxWidth?: number;
}

const { src, alt, sizes, class: className, priority = false, maxWidth } = Astro.props;

const CANDIDATES = [400, 640, 960, 1280, 1600, 1920, 2560];
const limit = Math.min(maxWidth ?? src.width, src.width);
const widths = [...CANDIDATES.filter((w) => w < limit), limit];
---

<Picture
  src={src}
  alt={alt}
  widths={widths}
  sizes={sizes}
  formats={['avif', 'webp']}
  class={className}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={priority ? 'high' : 'auto'}
  pictureAttributes={{ class: 'pic-contents' }}
/>
