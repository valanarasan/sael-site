---
/**
 * A content photo: AVIF, falling back to WebP, at several widths through astro:assets. No JPEG set:
 * every browser in use reads WebP, and it would add a long list to the HTML. width/height are set so
 * nothing shifts while loading. Lazy by default; `priority` is for the first hero image only.
 * The <picture> wrapper is display:contents so the <img> can be styled as if it stood alone.
 */
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { photoWidths } from '../../lib/photo';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The `sizes` attribute, e.g. "(max-width: 860px) 100vw, 50vw". */
  sizes: string;
  class?: string;
  /** First hero image only: loads eagerly with fetchpriority="high". */
  priority?: boolean;
  /**
   * Counts as on screen but isn't seen first (the hero slides behind the first): fetchpriority="low",
   * so the first photo and the fonts download ahead of it.
   */
  lowPriority?: boolean;
  /** Largest width to generate; defaults to the original's width. */
  maxWidth?: number;
}

const {
  src,
  alt,
  sizes,
  class: className,
  priority = false,
  lowPriority = false,
  maxWidth,
} = Astro.props;
const fetchPriority = priority ? 'high' : lowPriority ? 'low' : 'auto';
---

<Picture
  src={src}
  alt={alt}
  widths={photoWidths(src.width, maxWidth)}
  sizes={sizes}
  formats={['avif']}
  fallbackFormat="webp"
  class={className}
  loading={priority ? 'eager' : 'lazy'}
  decoding={priority ? 'sync' : 'async'}
  fetchpriority={fetchPriority}
  pictureAttributes={{ class: 'pic-contents' }}
/>
