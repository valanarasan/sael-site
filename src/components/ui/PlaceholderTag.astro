---
/** Visible marker for copy or figures SAEL still has to send. Remove by clearing `placeholder` in content. */
interface Props {
  label?: string;
}

const { label = 'Content from SAEL' } = Astro.props;
---

<span class="ph-tag">{label}</span>

<style>
  .ph-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    align-self: flex-start;
    padding: 5px 10px;
    border-radius: 999px;
    border: 1px dashed currentColor;
    font: 500 10.5px var(--f-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.7;
  }
</style>
