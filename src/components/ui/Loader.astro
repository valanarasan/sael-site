---
/**
 * The full-screen SAEL loader from v5: letters rise, the bar fills, the curtain lifts.
 * Hidden unless the <head> script in BaseLayout turned it on (first home visit of a session, with
 * JavaScript and without reduced motion). The animation itself is in lib/motion.ts. Decorative,
 * so hidden from screen readers.
 */
interface Props {
  word: string;
  tagline: string;
}

const { word, tagline } = Astro.props;
---

<div class="loader" aria-hidden="true" data-loader>
  <div class="word">
    {[...word].map((letter) => (
      <span data-loader-letter>{letter}</span>
    ))}
  </div>
  <div class="bar">
    <i data-loader-bar></i>
  </div>
  <div class="meta">
    <span>{tagline}</span>
    <span data-loader-count>000</span>
  </div>
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 max(var(--gut-l), 40px) 48px;
    background: var(--ink);
    color: var(--paper);
  }

  :global(.loader-on) .loader {
    display: flex;
  }

  /* If the motion script is blocked or very slow, the page still opens. */
  :global(.loader-on:not(.motion-on)) .loader {
    animation: loader-fallback 0s 3s forwards;
  }

  @keyframes loader-fallback {
    to {
      visibility: hidden;
    }
  }

  .word {
    display: flex;
    overflow: hidden;
    font: 800 clamp(80px, 18vw, 260px) / 0.8 var(--f-disp);
    letter-spacing: -0.05em;
  }

  .word span {
    display: inline-block;
    transform: translateY(105%);
  }

  .bar {
    position: relative;
    height: 2px;
    margin-top: 28px;
    overflow: hidden;
    background: rgba(241, 243, 241, 0.15);
  }

  .bar i {
    position: absolute;
    inset: 0;
    background: var(--copper);
    transform: scaleX(0);
    transform-origin: 0 50%;
  }

  .meta {
    display: flex;
    justify-content: space-between;
    margin-top: 14px;
    color: rgba(241, 243, 241, 0.6);
    font: 500 12px var(--f-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
</style>
